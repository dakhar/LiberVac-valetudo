{
  "/api/v2/robot/capabilities/MapSegmentRenumberCapability": {
    "put": {
      "tags": [
        "MapSegmentRenumberCapability"
      ],
      "summary": "Renumber map segment",
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string",
                  "enum": [
                    "set_order"
                  ]
                },
                "segment_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "All segment ids in the desired whole-home clean order (first cleaned first)."
                }
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "$ref": "#/components/responses/200"
        },
        "400": {
          "$ref": "#/components/responses/400"
        }
      }
    }
  },
  "/api/v2/robot/capabilities/MapSegmentRenumberCapability/properties": {
    "get": {
      "tags": [
        "MapSegmentRenumberCapability"
      ],
      "summary": "Get various capability-related properties",
      "responses": {
        "200": {
          "description": "Ok",
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  }
}
